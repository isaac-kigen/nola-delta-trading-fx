# Required
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
FINNHUB_API_KEY=your_finnhub_api_key
FINNHUB_FOREX_SOURCE=OANDA
FINNHUB_FETCH_MAX_RETRIES=3
FINNHUB_FETCH_BASE_DELAY_MS=400
FINNHUB_FETCH_TIMEOUT_MS=15000
FINNHUB_API_CALLS_PER_MIN=50
FINNHUB_API_CALLS_PER_DAY=50000

# Symbol defaults
FINNHUB_DEFAULT_SYMBOL=EUR/USD
FINNHUB_DEFAULT_SYMBOLS=EUR/USD,GBP/USD,USD/JPY,USD/CHF,AUD/USD,USD/CAD,NZD/USD,EUR/JPY,GBP/JPY,EUR/GBP
CHECK_TRADING_FUNCTION_NAME=check-trading-opportunity

# Telegram
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_MAX_MESSAGES_PER_HOUR=8
BROKER_EXEC_TELEGRAM_ENABLED=true
BROKER_EXEC_TELEGRAM_BOT_TOKEN=
BROKER_EXEC_TELEGRAM_CHAT_ID=
BROKER_EXEC_TELEGRAM_TIMEOUT_MS=10000

# Strategy risk defaults (DB config overrides these)
STRATEGY_ACCOUNT_EQUITY_USD=5000
STRATEGY_RISK_PER_TRADE_PCT=0.55
PHOTON_MIN_RR=2.0
PHOTON_ZONE_BASE_CANDLES=3
PHOTON_ZONE_BASE_MAX_PIPS=12
PHOTON_ZONE_IMPULSE_CANDLES=3
PHOTON_ZONE_IMPULSE_PIPS=20
PHOTON_ZONE_INVALIDATION_PIPS=1
PHOTON_LIQUIDITY_EPS_PIPS=2
PHOTON_LIQUIDITY_EPS_PIPS_JPY=0.2
PHOTON_ONE_TRADE_PER_CYCLE=true
STRUCTURE_MAX_1M_CANDLES=12000
STRUCTURE_MAX_15M_CANDLES=1200
STRUCTURE_REAL_1M_BURST_LIMIT=600
STRUCTURE_FETCH_PAGE_SIZE=1000
PHOTON_REQUIRE_REAL_1M_TRIGGER=true
PHOTON_REAL_1M_FRESHNESS_MINUTES=20
PHOTON_VALIDATION_MAX_CANDLES=20000
HIGH_IMPACT_NEWS_SYMBOLS=

# Broker execution (signal -> intent -> execution)
BROKER_EXECUTION_ENABLED=false
BROKER_EXECUTION_BROKER=paper
BROKER_EXECUTION_PROVIDER=paper
BROKER_EXECUTION_BATCH_SIZE=5
BROKER_EXECUTION_RETRY_SECONDS=120
BROKER_EXECUTION_MAX_ATTEMPTS=5
BROKER_RECLAIM_SENT_AFTER_SECONDS=300
BROKER_EXECUTION_LOCK_TTL_SECONDS=55
BROKER_EXECUTION_DISPATCH_ON_SIGNAL=true
BROKER_EXECUTION_DISPATCH_TIMEOUT_MS=15000
BROKER_EXECUTION_DISPATCH_LIMIT=5
BROKER_EXECUTION_DISPATCH_URL=
BROKER_CIRCUIT_BREAKER_ENABLED=true
BROKER_CIRCUIT_BREAKER_WINDOW_MINUTES=30
BROKER_CIRCUIT_BREAKER_MIN_SAMPLE=8
BROKER_CIRCUIT_BREAKER_MAX_ERRORS=6
BROKER_CIRCUIT_BREAKER_MAX_ERROR_RATE_PCT=70
BROKER_CHAOS_MODE=false
BROKER_CHAOS_FAILURE_RATE_PCT=0
BROKER_BRIDGE_URL=
BROKER_BRIDGE_TOKEN=
BROKER_BRIDGE_TIMEOUT_MS=15000

# Callback ingestion
BROKER_CALLBACK_URL=
BROKER_CALLBACK_SECRET=replace_with_a_long_random_secret
BROKER_CALLBACK_HEADER_NAME=x-callback-secret
BROKER_CALLBACK_PENDING_RETRY_SECONDS=90
CTRADER_CALLBACK_SECRET=replace_with_a_long_random_secret

# cTrader OAuth + OpenAPI
CTRADER_CLIENT_ID=your_ctrader_client_id
CTRADER_CLIENT_SECRET=your_ctrader_client_secret
CTRADER_OAUTH_STATE_SECRET=replace_with_a_long_random_secret
CTRADER_OAUTH_ENFORCE_STATE=true
CTRADER_OAUTH_ALLOW_LEGACY_STATE=false
CTRADER_OAUTH_STATE_TTL_SECONDS=600
CTRADER_OPENAPI_ENV=live
CTRADER_OPENAPI_WS_URL=
CTRADER_OPENAPI_PORT=5036
CTRADER_OPENAPI_TIMEOUT_MS=20000
CTRADER_ORDER_EVENT_TIMEOUT_MS=20000
CTRADER_TARGET_ACCOUNT_ID=
CTRADER_RUNTIME_BRIDGE_FALLBACK=true
CTRADER_DEFAULT_VOLUME_UNITS=10000
CTRADER_VOLUME_UNITS_MULTIPLIER=100
CTRADER_VOLUME_STEP=100
CTRADER_MIN_VOLUME=100
CTRADER_MAX_VOLUME=2000000000
CTRADER_OAUTH_REDIRECT_URI=https://your-project-ref.supabase.co/functions/v1/ctrader-oauth-callback
CTRADER_OAUTH_TOKEN_URL=https://openapi.ctrader.com/apps/token
CTRADER_OAUTH_AUTHORIZE_URL=https://id.ctrader.com/my/settings/openapi/grantingaccess/
CTRADER_OAUTH_SCOPE=accounts
CTRADER_OAUTH_PRODUCT=web
CTRADER_OAUTH_TIMEOUT_MS=15000
CTRADER_OAUTH_DEFAULT_CONNECTION_KEY=default
CTRADER_OAUTH_SUCCESS_REDIRECT_URL=
CTRADER_OAUTH_ERROR_REDIRECT_URL=

# Broker position sync
BROKER_POSITIONS_SYNC_URL=
BROKER_POSITIONS_SYNC_TOKEN=
BROKER_POSITIONS_SYNC_TIMEOUT_MS=15000
BROKER_POSITIONS_SYNC_BATCH_SIZE=150
BROKER_SYNC_LOCK_TTL_SECONDS=90
BROKER_SYNC_DISPATCH_AFTER_EXECUTION=true
BROKER_SYNC_DISPATCH_URL=

# Global lock/auth hardening
LOCK_ENABLED=true
LOCK_FAIL_OPEN=true
REQUIRE_INTERNAL_AUTH=true
REQUIRE_CALLBACK_AUTH=true

# Cron/API guards (set all in production)
SYNC_CRON_SECRET=replace_with_a_long_random_secret
CHECK_CRON_SECRET=replace_with_a_long_random_secret
BACKFILL_CRON_SECRET=replace_with_a_long_random_secret
VALIDATE_CRON_SECRET=replace_with_a_long_random_secret
EXECUTE_CRON_SECRET=replace_with_a_long_random_secret
BROKER_SYNC_CRON_SECRET=replace_with_a_long_random_secret
SYNC_LOCK_TTL_SECONDS=1800
BACKFILL_LOCK_TTL_SECONDS=7200
BACKFILL_MAX_CHUNKS_PER_RUN=120
BACKFILL_SKIP_EMPTY_CHUNKS=true
VALIDATION_PAGE_SIZE=1000
